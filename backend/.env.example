SPORTS_API_KEY=your_api_football_key
SPORTS_API_BASE_URL=https://v3.football.api-sports.io
# Free API-Sports plans: use 2022-2024 only. Paid plans can use current season.
SPORTS_API_SEASON=2024
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CACHE_TTL_SECONDS=300
DEFAULT_SPORT=soccer
USE_MOCK_SPORTS_DATA=false
USE_MOCK_LLM=false
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PRICE_ID=your_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
# Optional: used to resolve user email when it is not present in the JWT
CLERK_SECRET_KEY=your_clerk_secret_key
FRONTEND_URL=http://localhost:5173
# Comma-separated admin email prefixes or full addresses (e.g. bombe or bombe@example.com)
ADMIN_EMAIL_WHITELIST=bombe
